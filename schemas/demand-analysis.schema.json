{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duduhire.com/schemas/demand-analysis.schema.json",
  "title": "Duduhire pain-point analysis",
  "description": "Machine-readable contract for turning a user's problem statement into a grounded, reviewable demand brief.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source",
    "facts",
    "problem",
    "uncertainties",
    "questions",
    "matching_input",
    "risk_flags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "needs_clarification",
        "ready_for_matching",
        "requires_human_review"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language",
        "sensitive"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "sensitive": {
          "type": "boolean"
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/grounded_fact"
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "scene",
        "stage",
        "affected_actors",
        "impact",
        "attempts",
        "desired_outcome",
        "constraints",
        "acceptance_criteria",
        "root_cause_status",
        "root_cause_hypotheses"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "scene": {
          "$ref": "#/$defs/nullable_short_text"
        },
        "stage": {
          "$ref": "#/$defs/nullable_short_text"
        },
        "affected_actors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "metrics"
          ],
          "properties": {
            "description": {
              "$ref": "#/$defs/nullable_medium_text"
            },
            "metrics": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "baseline",
                  "current",
                  "time_window",
                  "source_fact_ids"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "baseline": {
                    "$ref": "#/$defs/nullable_short_text"
                  },
                  "current": {
                    "$ref": "#/$defs/nullable_short_text"
                  },
                  "time_window": {
                    "$ref": "#/$defs/nullable_short_text"
                  },
                  "source_fact_ids": {
                    "$ref": "#/$defs/fact_ids"
                  }
                }
              }
            }
          }
        },
        "attempts": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "result",
              "source_fact_ids"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "result": {
                "$ref": "#/$defs/nullable_medium_text"
              },
              "source_fact_ids": {
                "$ref": "#/$defs/fact_ids"
              }
            }
          }
        },
        "desired_outcome": {
          "$ref": "#/$defs/nullable_medium_text"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deadline",
            "budget",
            "data_access",
            "stakeholders",
            "forbidden_actions"
          ],
          "properties": {
            "deadline": {
              "$ref": "#/$defs/nullable_short_text"
            },
            "budget": {
              "$ref": "#/$defs/nullable_short_text"
            },
            "data_access": {
              "$ref": "#/$defs/nullable_medium_text"
            },
            "stakeholders": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "forbidden_actions": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "source"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "source": {
                "enum": [
                  "user_stated",
                  "proposed_for_confirmation"
                ]
              }
            }
          }
        },
        "root_cause_status": {
          "enum": [
            "unknown",
            "hypothesis",
            "verified"
          ]
        },
        "root_cause_hypotheses": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis",
              "basis_fact_ids",
              "needs_verification"
            ],
            "properties": {
              "hypothesis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "basis_fact_ids": {
                "$ref": "#/$defs/fact_ids"
              },
              "needs_verification": {
                "const": true
              }
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "matching_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_summary",
        "required_capabilities",
        "market",
        "hard_filters"
      ],
      "properties": {
        "task_summary": {
          "type": "string",
          "maxLength": 500
        },
        "required_capabilities": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "expected_deliverable",
              "evidence_needed"
            ],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "expected_deliverable": {
                "$ref": "#/$defs/nullable_short_text"
              },
              "evidence_needed": {
                "$ref": "#/$defs/nullable_medium_text"
              }
            }
          }
        },
        "market": {
          "$ref": "#/$defs/nullable_short_text"
        },
        "hard_filters": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "risk_flags": {
      "$ref": "#/$defs/risk_flags"
    }
  },
  "$defs": {
    "nullable_short_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "nullable_medium_text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "fact_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^f_[a-zA-Z0-9_-]+$"
      }
    },
    "grounded_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "claim",
        "source_quote",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f_[a-zA-Z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "context",
            "symptom",
            "impact",
            "attempt",
            "goal",
            "constraint",
            "actor",
            "deadline",
            "budget",
            "data_access"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason",
        "blocking"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targets",
        "question",
        "reason",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q_[a-zA-Z0-9_-]+$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "enum": [
          "personal_sensitive_data",
          "confidential_business_data",
          "unsafe_or_illegal",
          "prompt_injection",
          "unsupported_financial_claim",
          "high_impact_decision",
          "other"
        ]
      }
    }
  }
}
