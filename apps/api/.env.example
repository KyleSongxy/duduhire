NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://duduhire:duduhire@127.0.0.1:5432/duduhire
DATABASE_SSL=false
# Optional in development; production requires dedicated owner/maintenance connections.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_SSL=
MAINTENANCE_DATABASE_URL=
MAINTENANCE_DATABASE_SSL=
WEB_ORIGIN=http://localhost:5173
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=duduhire_session
AUTH_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
EMAIL_RESEND_SECONDS=60
EMAIL_HOURLY_LIMIT=5
# Local development only. Production Compose defaults to smtp and validates SMTP_URL/EMAIL_FROM.
# Native production must explicitly set smtp or disabled; console is always rejected in production.
# Explicit disabled needs no SMTP_URL/EMAIL_FROM and rejects all email authentication requests.
EMAIL_DELIVERY_MODE=console
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="DuduHire <no-reply@example.com>"
# Real Qwen requests are the default. Set AI_MODE=local explicitly only for offline development/tests.
AI_MODE=qwen
# Server-only Alibaba Cloud key. DASHSCOPE_API_KEY is accepted when QWEN_API_KEY is empty.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
# Use the region that matches your API key; see docs/DEPLOYMENT.md for workspace endpoints.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional legacy provider, only used with AI_MODE=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Generate with: openssl rand -hex 32
CONTACT_DATA_KEY=
CONTACT_DATA_KEY_ID=contact-development-2026-09
LOG_LEVEL=info
# Leave empty for direct access; use the exact reverse-proxy IP/CIDR in production.
TRUST_PROXY_CIDRS=
# Comma-separated existing verified user UUIDs. Empty disables all admin access.
ADMIN_USER_IDS=
# Leave recipient empty to disable notifications. Use a dedicated DB role when enabled.
INQUIRY_NOTIFICATION_EMAIL=
NOTIFICATION_DATABASE_URL=
INQUIRY_NOTIFICATION_POLL_MS=5000
