{
  "name": "duduhire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm run dev --workspace @duduhire/api\" \"npm run dev --workspace @duduhire/web\"",
    "dev:api": "npm run dev --workspace @duduhire/api",
    "dev:web": "npm run dev --workspace @duduhire/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "test:integration": "npm run test:integration --workspace @duduhire/api",
    "test:integration:phone": "npm run test:integration:phone --workspace @duduhire/api",
    "test:qwen": "npm run test:qwen --workspace @duduhire/api",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check:repository && npm run lint && npm run test && npm run build",
    "db:migrate": "npm run db:migrate --workspace @duduhire/api",
    "db:migrate:compiled": "npm run db:migrate:compiled --workspace @duduhire/api",
    "auth:cleanup": "npm run auth:cleanup --workspace @duduhire/api",
    "auth:cleanup:compiled": "npm run auth:cleanup:compiled --workspace @duduhire/api",
    "auth:configure:pnvs": "npm run auth:configure:pnvs --workspace @duduhire/api",
    "data:cleanup": "npm run data:cleanup --workspace @duduhire/api",
    "data:cleanup:compiled": "npm run data:cleanup:compiled --workspace @duduhire/api",
    "contact-key:rotate": "npm run contact-key:rotate --workspace @duduhire/api",
    "contact-key:rotate:compiled": "npm run contact-key:rotate:compiled --workspace @duduhire/api",
    "start:api": "npm run start --workspace @duduhire/api",
    "preview:web": "npm run preview --workspace @duduhire/web",
    "db:seed:matching": "npm run db:seed:matching --workspace @duduhire/api",
    "check:repository": "node tools/check-repository.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5"
  }
}
