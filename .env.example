# Configure hosted values through Sites. Never expose these keys in browser code.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Durable per-source model request limit backed by D1 when available.
AI_REQUESTS_PER_10_MINUTES=10
RATE_LIMIT_SALT=

# Comma-separated workspace-authenticated reviewer emails.
# REVIEW_ADMIN_TOKEN is an optional fallback for external admin access.
REVIEWER_EMAILS=
REVIEW_ADMIN_TOKEN=

# balanced: short demand -> Qwen Flash; complex/refined -> Qwen Plus.
# Alternatives: cost, quality.
MODEL_ROUTING_POLICY=balanced
